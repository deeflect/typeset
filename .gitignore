# XcodeGen-generated project (checked-in source of truth is project.yml)
*.xcodeproj
*.xcworkspace

# Xcode
xcuserdata/
DerivedData/
*.xcuserstate
*.xcscmblueprint

# Swift Package Manager
.build/
.swiftpm/

# Large synthetic fixtures (regenerate with Scripts/make-fixtures.sh)
Tests/Fixtures/generated/

# macOS
.DS_Store

# Local build output for snapshot/verification (see SnapshotRunner)
# Any local build/derived-data scratch dir: .build-dd, .build-snap,
# .build-release (Scripts/release.sh), ad-hoc ones, etc.
.build-*/

# Claude Code local project state
.claude/
.impeccable/

# Website
site/node_modules
site/dist
site/.astro

# Tesseract render scratch
.tesseract-work/

# Per-machine signing overrides
Config/Local.xcconfig

# larger than 20MB — excluded by agent-guard
.build-dd/Build/Intermediates.noindex/XCBuildData/build.db
.build-dd/Build/Products/Release/MarcoQuickLook.appex.dSYM/Contents/Resources/DWARF/MarcoQuickLook
.build-dd/Build/Products/Release/Marco.app.dSYM/Contents/Resources/DWARF/Marco
.build-release/Marco.xcarchive/dSYMs/MarcoQuickLook.appex.dSYM/Contents/Resources/DWARF/MarcoQuickLook
.build-release/Marco.xcarchive/dSYMs/Marco.app.dSYM/Contents/Resources/DWARF/Marco
.build-release/Typeset.xcarchive/dSYMs/Typeset.app.dSYM/Contents/Resources/DWARF/Typeset
