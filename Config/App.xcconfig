// Single source of truth for renaming the app.
// To rename the shipped app: edit these values (see README.md).

APP_NAME = Typeset
APP_BUNDLE_ID = com.deeflect.typeset
MARKETING_VERSION = 1.1.0

// Shown in Get Info and the App Store listing. Xcode strips a literal
// copyright sign, so it is spelled out.
APP_COPYRIGHT = Copyright (c) 2026 Dmitry Kargaev. All rights reserved.

CURRENT_PROJECT_VERSION = 3
SWIFT_VERSION = 6.0
MACOSX_DEPLOYMENT_TARGET = 26.0
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
ENABLE_HARDENED_RUNTIME = YES

// Optional per-machine overrides (your own DEVELOPMENT_TEAM, bundle ID). Not checked in.
#include? "Local.xcconfig"
