<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  App Store submissions must declare a privacy manifest. Marco collects
	  nothing and makes no network calls (there is deliberately no
	  com.apple.security.network.client entitlement), so the only entry is the
	  required-reason API it genuinely uses.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!--
			  Text size (⌘+/⌘−/⌘0), remembered scroll anchors, the recent-files
			  list and its security-scoped bookmarks. All app-local state for
			  the user's own settings; never read from or written to any other
			  app or shared container.
			-->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
